            "^TestParseDelimitedTokens$"
          ],
          "cwd": ".",
          "timeout_seconds": 10,
          "expected_exit_code": 0,
          "scope": "unit",
          "capability": "local",
          "assertions": [
            {
              "kind": "go_test_pass",
              "target": "parserboundary/TestParseDelimitedTokens",
              "expected": true
            }
          ]
        }
      ],
      "stop_conditions": [
        "Depth violation must fail immediately without reading entire stream"
      ],
      "return_format": "sila/task-result/v1"
    }
