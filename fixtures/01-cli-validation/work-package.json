      "requirement": "Default options populated when args are empty",
      "given": "Empty args slice",
      "action": "Call ValidateAndParseRunOptions",
      "expected": "Timeout=30, Format=text, Strict=false, err=nil",
      "required_scope": "unit",
      "mandatory": true,
