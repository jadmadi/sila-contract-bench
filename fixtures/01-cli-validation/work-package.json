      "expected": "Returns INVALID_TIMEOUT or INVALID_FORMAT error",
      "required_scope": "unit",
      "mandatory": true,
      "check_ids": [
        "C-001"
      ]
    },
    {
      "id": "AC-003",
      "requirement": "Unknown flag returns UNKNOWN_FLAG error",
      "given": "Flag --foo=bar not in recognized set",
      "action": "Call ValidateAndParseRunOptions",
      "expected": "Returns UNKNOWN_FLAG: --foo=bar error",
      "required_scope": "unit",
      "mandatory": true,
