+package taskcancellation
+
+import (
+	"context"
+)
+
+// PipelineStep represents an executable step within a pipeline.
+type PipelineStep interface {
+	Run(ctx context.Context) error
+}
+
+// PipelineStepFunc is an adapter to allow the use of ordinary functions as pipeline steps.
+type PipelineStepFunc func(ctx context.Context) error
+
+// Run calls f(ctx).
+func (f PipelineStepFunc) Run(ctx context.Context) error {
+	return f(ctx)
+}
+
+// PipelineResult contains the execution results of a pipeline.
+type PipelineResult struct {
+	CompletedCount int
+}
+
+// ExecutePipeline executes a sequence of pipeline steps in order.
+// If the context is canceled or a step fails, execution halts immediately,
+// onCleanup is called (if non-nil), and an error is returned.
+// onCleanup is not called if all steps complete successfully.
+func ExecutePipeline(ctx context.Context, steps []PipelineStep, onCleanup func()) (*PipelineResult, error) {
+	result := &PipelineResult{CompletedCount: 0}
+
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	if err := ctx.Err(); err != nil {
+		if onCleanup != nil {
+			onCleanup()
+		}
+		return result, err
+	}
+
+	for _, step := range steps {
+		if err := ctx.Err(); err != nil {
+			if onCleanup != nil {
+				onCleanup()
+			}
+			return result, err
+		}
+
+		if step != nil {
+			if err := step.Run(ctx); err != nil {
+				if onCleanup != nil {
+					onCleanup()
+				}
+				if ctxErr := ctx.Err(); ctxErr != nil {
+					return result, ctxErr
+				}
+				return result, err
+			}
+		}
+
+		if err := ctx.Err(); err != nil {
+			if onCleanup != nil {
+				onCleanup()
+			}
+			return result, err
+		}
+
+		result.CompletedCount++
+	}
+
+	return result, nil
+}
