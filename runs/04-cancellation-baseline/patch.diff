+package taskcancellation
+
+import "context"
+
+type PipelineStep struct {
+	Name string
+	Run  func(ctx context.Context) error
+}
+
+type PipelineResult struct {
+	CompletedCount int
+}
+
+// ExecutePipeline executes steps sequentially, checking for context cancellation
+// before and between every step, and invoking onCleanup if cancelled or if a step fails.
+func ExecutePipeline(ctx context.Context, steps []PipelineStep, onCleanup func()) (*PipelineResult, error) {
+	cleanup := func() {
+		if onCleanup != nil {
+			onCleanup()
+			onCleanup = nil
+		}
+	}
+
+	if err := ctx.Err(); err != nil {
+		cleanup()
+		return nil, err
+	}
+
+	for _, step := range steps {
+		if err := ctx.Err(); err != nil {
+			cleanup()
+			return nil, err
+		}
+
+		if step.Run != nil {
+			if err := step.Run(ctx); err != nil {
+				cleanup()
+				return nil, err
+			}
+		}
+	}
+
+	return &PipelineResult{
+		CompletedCount: len(steps),
+	}, nil
+}
