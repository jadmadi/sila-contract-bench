+package filepreservation
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// SafeAtomicUpdate safely updates the file at targetPath using updateFn.
+// 1. If targetPath exists, its contents are read and passed to updateFn.
+//    If it does not exist, nil is passed to updateFn.
+// 2. If updateFn returns an error, that error is returned immediately,
+//    leaving targetPath untouched and cleaning up any temporary files.
+// 3. If updateFn succeeds:
+//    - New bytes are written to a temporary sibling file in filepath.Dir(targetPath).
+//    - File contents are synced to disk.
+//    - Original file permissions are preserved (or defaulted to 0644 for new files).
+//    - The temporary file is atomically renamed over targetPath.
+func SafeAtomicUpdate(targetPath string, updateFn func(old []byte) ([]byte, error)) error {
+	if updateFn == nil {
+		return fmt.Errorf("updateFn must not be nil")
+	}
+
+	var oldData []byte
+	perm := os.FileMode(0644)
+
+	info, err := os.Stat(targetPath)
+	if err == nil {
+		if info.IsDir() {
+			return fmt.Errorf("target path %q is a directory", targetPath)
+		}
+		perm = info.Mode().Perm()
+		data, readErr := os.ReadFile(targetPath)
+		if readErr != nil {
+			return fmt.Errorf("reading target file: %w", readErr)
+		}
+		oldData = data
+	} else if errors.Is(err, os.ErrNotExist) || os.IsNotExist(err) {
+		oldData = nil
+	} else {
+		return fmt.Errorf("checking target file: %w", err)
+	}
+
+	newData, err := updateFn(oldData)
+	if err != nil {
+		return err
+	}
+
+	dir := filepath.Dir(targetPath)
+	base := filepath.Base(targetPath)
+
+	tmpFile, err := os.CreateTemp(dir, "."+base+".*.tmp")
+	if err != nil {
+		return fmt.Errorf("creating temp file: %w", err)
+	}
+	tmpPath := tmpFile.Name()
+
+	var success bool
+	var closed bool
+	defer func() {
+		if !closed {
+			_ = tmpFile.Close()
+		}
+		if !success {
+			_ = os.Remove(tmpPath)
+		}
+	}()
+
+	if _, err := tmpFile.Write(newData); err != nil {
+		return fmt.Errorf("writing to temp file: %w", err)
+	}
+
+	if err := tmpFile.Sync(); err != nil {
+		return fmt.Errorf("syncing temp file: %w", err)
+	}
+
+	if err := tmpFile.Chmod(perm); err != nil {
+		return fmt.Errorf("setting permissions on temp file: %w", err)
+	}
+
+	if err := tmpFile.Close(); err != nil {
+		return fmt.Errorf("closing temp file: %w", err)
+	}
+	closed = true
+
+	if err := os.Rename(tmpPath, targetPath); err != nil {
+		return fmt.Errorf("renaming temp file to target path: %w", err)
+	}
+	success = true
+
+	return nil
+}
